{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ri-legal-group",
  "account_id": "3570800343e1a5c43e0f001f63f9638b",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  // The static site. The Worker runs first and falls through to these.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // Sending is restricted to one from-address so a mistake cannot send as
  // anything else on the domain. The `to` is pinned in worker/index.js.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["intake@rilegalgroup.com"]
    }
  ],

  // Apex and www. These replace the Squarespace records that were removed.
  "routes": [
    { "pattern": "rilegalgroup.com", "custom_domain": true },
    { "pattern": "www.rilegalgroup.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
